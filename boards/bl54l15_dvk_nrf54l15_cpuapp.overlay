/* Custom SPS carrier with Ezurio BL54L15 (453-00001R). */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/* Move the settings label to NOR; leave the previous RRAM area unused. */
/delete-node/ &storage_partition;
/delete-node/ &slot1_partition;
/delete-node/ &slot0_partition;
&boot_partition { reg = <0x0 0x20000>; };
&cpuapp_rram {
	partitions {
		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x20000 0x100000>;
		};
		unused_internal_storage: partition@15c000 {
			label = "unused-internal-storage";
			reg = <0x15c000 0x9000>;
		};
	};
};

/ {
	/* The DVK peripherals are not fitted on this custom carrier. */
	leds { status = "disabled"; };
	buttons { status = "disabled"; };
	pwmleds { status = "disabled"; };

	chosen {
		nordic,pm-ext-flash = &mx25r64;
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;
	};

	aliases {
		hlw-uart = &uart30;
		gsm-uart = &uart20;
		spi-flash = &mx25r64;

		batt-volt-adc = &batt_volt_adc;

		utility-pwr-led = &utility_pwr_led;
		fuse-detection = &fuse_detection;
		cellular-led = &cellular_led;

		relay1 = &relay_1;
		relay2 = &relay_2;
		relay3 = &relay_3;
		relay4 = &relay_4;

		gsm-ri = &gsm_ri;
		gsm-dtr = &gsm_dtr;
		gsm-pwrkey = &gsm_pwrkey;

		energy-metering-mux-a = &energy_metering_mux_logic_a;
		energy-metering-mux-b = &energy_metering_mux_logic_b;
	};

	sps_gpios {
		compatible = "sps,gpio-signals";
		utility_pwr_led: utility-pwr-led {
			gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
		};

		/* External R78 pulls high; the optocoupler pulls low with input AC. */
		fuse_detection: fuse-detection {
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		};

		cellular_led: cellular-led {
			gpios = <&gpio2 9 GPIO_ACTIVE_LOW>;
		};

		relay_1: relay-1 {
			gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		};

		relay_2: relay-2 {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		};

		relay_3: relay-3 {
			gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		};

		relay_4: relay-4 {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		};

		/* P1.09 is reserved for future debug TX and remains unconfigured. */
		gsm_ri: gsm-ri {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};

		gsm_dtr: gsm-dtr {
			gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
		};

		gsm_pwrkey: gsm-pwrkey {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};

		energy_metering_mux_logic_a: energy-metering-mux-logic-a {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};

		energy_metering_mux_logic_b: energy-metering-mux-logic-b {
			gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
		};
	};

	zephyr,user {
		io-channels = <&adc 4>;
	};
};

&pinctrl {
	/* FLASH_CLK P2.01, FLASH_IO0 P2.02, FLASH_IO1 P2.04. */
	sps_flash_default: sps_flash_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	sps_flash_sleep: sps_flash_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};

	hlw_uart_default: hlw_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 1)>;
		};
	};

	hlw_uart_sleep: hlw_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};

	gsm_uart_default: gsm_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
		};
	};

	gsm_uart_sleep: gsm_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};
};

&uart30 {
	status = "okay";
	current-speed = <9600>;
	parity = "even";
	pinctrl-0 = <&hlw_uart_default>;
	pinctrl-1 = <&hlw_uart_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&gsm_uart_default>;
	pinctrl-1 = <&gsm_uart_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	batt_volt_adc: channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};
};

/* Hardware SPIM00 matches the confirmed flash wiring. */
&spi00 {
	status = "okay";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&sps_flash_default>;
	pinctrl-1 = <&sps_flash_sleep>;
	pinctrl-names = "default", "sleep";
};

&mx25r64 {
	status = "okay";
	spi-max-frequency = <8000000>;
	/* FLASH_IO3 / RESET# is P2.00 in single-lane SPI mode. */
	reset-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0x000000 0x100000>;
		};
		ota_image_b: partition@100000 {
			label = "ota-image-b";
			reg = <0x100000 0x100000>;
		};
		scratch_partition: partition@200000 {
			label = "image-scratch";
			reg = <0x200000 0x2000>;
		};
		nvs_storage: partition@202000 {
			label = "boot-control";
			reg = <0x202000 0x2000>;
		};
		/* Keep persisted settings in place while reserving future growth. */
		ota_growth_reserve: partition@204000 {
			label = "ota-growth-reserve";
			reg = <0x204000 0x1fc000>;
		};
		storage_partition: partition@400000 {
			label = "settings-storage";
			reg = <0x400000 0x010000>;
		};
		data_storage: partition@410000 {
			label = "data-storage";
			reg = <0x410000 0x3f0000>;
		};
	};
};

/* PWM20 would otherwise claim P1.10 (GSM_PWRKEY). */
&pwm20 {
	status = "disabled";
};

&button0 { status = "disabled"; };
&button1 { status = "disabled"; };
&button2 { status = "disabled"; };
&button3 { status = "disabled"; };
&led0 { status = "disabled"; };
&led1 { status = "disabled"; };
&led2 { status = "disabled"; };
&led3 { status = "disabled"; };
&pwm_led1 { status = "disabled"; };

/* Keep FLASH_IO2 / WP# high in single-lane SPI mode. */
&gpio2 {
	flash_wp {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "FLASH_IO2_WP_N";
	};
};

/* Shared 20-second hardware watchdog, handed from MCUboot to the application. */
&wdt30 { status = "okay"; };
